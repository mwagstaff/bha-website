{
  "name": "bha-website",
  "version": "0.1.0",
  "private": true,
  "description": "Beckenham & Bromley Historical Association — modern website proof of concept",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env.local --watch server.js",
    "test": "node --test",
    "pull-content": "zsh scripts/pull-content.zsh",
    "deploy:preview": "zsh scripts/pull-content.zsh live && ~/dev/server-tooling/deploy/node_project.zsh bha bw",
    "deploy:live": "zsh scripts/pull-content.zsh live && ~/dev/server-tooling/deploy/node_project.zsh bha-live bw"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "mongodb": "^6.21.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  }
}
